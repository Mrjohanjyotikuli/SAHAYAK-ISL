BT /F3 6.55 Tf 53 542 Td (@') Tj ET
BT /F3 6.55 Tf 53 533 Td (import argparse) Tj ET
BT /F3 6.55 Tf 53 524 Td (import json) Tj ET
BT /F3 6.55 Tf 53 515 Td (import sqlite3) Tj ET
BT /F3 6.55 Tf 53 506 Td (import joblib) Tj ET
BT /F3 6.55 Tf 53 497 Td (import numpy as np) Tj ET
BT /F3 6.55 Tf 53 488 Td (from sequence_features import summarize_sequence) Tj ET
BT /F3 6.55 Tf 53 479 Td () Tj ET
BT /F3 6.55 Tf 53 470 Td (parser = argparse.ArgumentParser\(\)) Tj ET
BT /F3 6.55 Tf 53 461 Td (parser.add_argument\("--after-id", type=int, required=True\)) Tj ET
BT /F3 6.55 Tf 53 452 Td (args = parser.parse_args\(\)) Tj ET
BT /F3 6.55 Tf 53 443 Td (model = joblib.load\("model/sahayak_sequence_candidate.joblib"\)) Tj ET
BT /F3 6.55 Tf 53 434 Td (with sqlite3.connect\("continuous_gesture_db.db"\) as db:) Tj ET
BT /F3 6.55 Tf 53 425 Td (    rows = db.execute\() Tj ET
BT /F3 6.55 Tf 53 416 Td (        "SELECT id, label, frames_json FROM sequence_samples WHERE id > ? ORDER BY id",) Tj ET
BT /F3 6.55 Tf 53 407 Td (        \(args.after_id,\),) Tj ET
BT /F3 6.55 Tf 53 398 Td (    \).fetchall\(\)) Tj ET
BT /F3 6.55 Tf 53 389 Td (if not rows:) Tj ET
BT /F3 6.55 Tf 53 380 Td (    raise SystemExit\("No fresh test samples found."\)) Tj ET
BT /F3 6.55 Tf 53 371 Td (X = np.asarray\([summarize_sequence\(json.loads\(frames\)\) for _, _, frames in rows]\)) Tj ET
BT /F3 6.55 Tf 53 362 Td (y = np.asarray\([label for _, label, _ in rows]\)) Tj ET
BT /F3 6.55 Tf 53 353 Td (pred = model.predict\(X\)) Tj ET
BT /F3 6.55 Tf 53 344 Td (print\("Fresh samples:", len\(rows\)\)) Tj ET
BT /F3 6.55 Tf 53 335 Td (print\("Accuracy:", round\(float\(np.mean\(y == pred\)\) * 100, 1\), "%"\)) Tj ET
BT /F3 6.55 Tf 53 326 Td (for label in sorted\(set\(y\)\):) Tj ET
BT /F3 6.55 Tf 53 317 Td (    mask = y == label) Tj ET
BT /F3 6.55 Tf 53 308 Td (    correct = int\(np.sum\(\(pred == y\) & mask\)\)) Tj ET
BT /F3 6.55 Tf 53 299 Td (    print\(f"{label}: {correct}/{int\(np.sum\(mask\)\)} correct"\)) Tj ET
BT /F3 6.55 Tf 53 290 Td ('@ | Set-Content ".\\test_sequence_candidate.py" -Encoding utf8) Tj ET
